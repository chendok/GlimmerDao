# 微光问道 - 环境配置模板
# 复制此文件为 .env 并填入实际值

# 应用配置
DEBUG=true

# LLM 配置 (OpenAI 兼容)
# 快速模式 LLM（响应快、成本低）- 对应对话框"快速"
FAST_LLM_API_KEY=your-api-key
FAST_LLM_MODEL=your-model
FAST_LLM_BASE_URL=https://api.openai.com/v1
FAST_LLM_TEMPERATURE=0.7

# 思考模式 LLM（深度思考、质量高）- 对应对话框"思考"
THINK_LLM_API_KEY=your-api-key
THINK_LLM_MODEL=your-model
THINK_LLM_BASE_URL=https://api.openai.com/v1
THINK_LLM_TEMPERATURE=0.3

# 视觉 LLM（支持图片输入，用于 OCR/图片解析）- 可选
# 未配置时回退到 FAST_LLM（若 FAST_LLM 不支持图片将返回友好提示）
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
VISION_LLM_BASE_URL=https://api.openai.com/v1

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/wendao.db

# 服务
HOST=0.0.0.0
PORT=5050

# Agent 配置
MAX_TOOL_ITERATIONS=10
MAX_CONVERSATION_TOKENS=8000

# JWT 认证配置（生产环境务必修改为随机强密钥）
JWT_SECRET_KEY=please-change-me-to-a-random-secret

# 安全配置
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
SMS_CODE_EXPIRE_MINUTES=5
SMS_CODE_COOLDOWN_SECONDS=60

# 腾讯云短信服务配置
TENCENT_SMS_SDK_APP_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_LOGIN=
TENCENT_SMS_TEMPLATE_REGISTER=
TENCENT_SMS_TEMPLATE_RESET=
# 未配置完整的腾讯云凭据时，自动降级为本地模拟发送
SMS_SIMULATE=true

# 邮件服务配置 (SMTP)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=微光问道
EMAIL_CODE_EXPIRE_MINUTES=15
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_MAX_ATTEMPTS=5
EMAIL_SIMULATE=true
